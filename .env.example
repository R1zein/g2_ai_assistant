# ---------------------------------------------------------------------------
# Assistant server. Copy to .env at the repository root.
#   cp .env.example .env
# `npm run dev:server` loads it automatically.
# ---------------------------------------------------------------------------

# --- HTTP -------------------------------------------------------------------
PORT=8787
HOST=0.0.0.0
# The URL the phone's browser can reach. Used to build the pairing link and the
# Google OAuth redirect, so it must be correct even in development — an ngrok or
# Cloudflare Tunnel URL works well there.
PUBLIC_BASE_URL=http://localhost:8787
LOG_LEVEL=info
DATA_DIR=data

# --- Anthropic --------------------------------------------------------------
# Optional shared fallback. Each account normally adds its own key in the phone
# panel; that key is billed to them and stored encrypted. Leave this empty to
# require a personal key from everyone.
ANTHROPIC_API_KEY=

# Refuse to answer for accounts that have not added their own key, even when the
# shared key above is set.
REQUIRE_USER_API_KEY=false

# Required before any account can store a personal key. Generate with:
#   openssl rand -base64 32
# Changing it invalidates every stored key — everyone has to paste theirs again.
ENCRYPTION_KEY=

# Models.
ASSISTANT_MODEL=claude-opus-5
# Extraction is one narrow, well-specified call per candidate email, so it runs
# on the small model. See docs/architecture.md for the cost arithmetic.
EXTRACTION_MODEL=claude-haiku-4-5

# Effort trades depth for latency. `fast` answers into a HUD while the wearer is
# standing still, so it runs below the API default of `high`; `deep` is already
# waiting on web round-trips, so it can afford more.
# One of: low | medium | high | xhigh | max
ASSISTANT_EFFORT=medium
DEEP_EFFORT=high
EXTRACTION_EFFORT=low

# Opt into the server-side refusal fallback so a declined turn still answers.
REFUSAL_FALLBACK=true

# Guardrails on a single question, per mode.
MAX_AGENT_ITERATIONS=8
AGENT_TIMEOUT_MS=45000
DEEP_MAX_AGENT_ITERATIONS=12
DEEP_AGENT_TIMEOUT_MS=90000

# --- Web access (deep mode) -------------------------------------------------
# Cap on server-side web search / fetch calls within a single question.
WEB_MAX_USES=6
# Comma-separated hostnames the web tools may never touch. Empty means no block
# list. Plain hostnames only — no scheme, no path.
WEB_BLOCKED_DOMAINS=

# --- Google -----------------------------------------------------------------
# From https://console.cloud.google.com/apis/credentials — an OAuth client of
# type "Web application". See docs/setup.md for the exact steps.
GOOGLE_CLIENT_ID=...apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=...
# Must match an Authorised redirect URI on the OAuth client, byte for byte.
GOOGLE_REDIRECT_URI=http://localhost:8787/auth/google/callback

# --- Speech to text ---------------------------------------------------------
# none   — voice input disabled, typed questions still work
# google — Cloud Speech-to-Text v1 (needs GOOGLE_SPEECH_API_KEY)
# openai — an OpenAI-compatible /v1/audio/transcriptions endpoint
STT_PROVIDER=none
GOOGLE_SPEECH_API_KEY=
OPENAI_API_KEY=
OPENAI_STT_MODEL=whisper-1

# --- Mail scanning ----------------------------------------------------------
# 0 disables the background pass; the glasses menu can still trigger one.
GMAIL_SYNC_INTERVAL_MS=900000
# How far back the very first scan reaches.
GMAIL_BACKFILL_DAYS=30
# Reservations are mirrored into this calendar, created on first use.
BOOKINGS_CALENDAR_NAME=Travel & Bookings
# Minutes before a booking that a card is pushed to the glasses.
REMINDER_LEAD_MINUTES=1440,120,30

# --- Photo feed -------------------------------------------------------------
# Access Key from an app at unsplash.com/oauth/applications. Empty disables the
# feed. Demo apps get 50 requests an hour — which is why photos are fetched in
# batches rather than one per swipe. Production approval raises it to 1,000/hour;
# see docs/photo-feed.md before applying.
UNSPLASH_ACCESS_KEY=
# Sent in the UTM parameters Unsplash requires on every link back.
UNSPLASH_APP_NAME=g2-ai-assistant
# Search term for the feed. Empty means whatever Unsplash feels like.
PHOTO_QUERY=
# Rendered frame size. Image containers cap at 288x144.
PHOTO_WIDTH=288
PHOTO_HEIGHT=144
PHOTO_BATCH_SIZE=24
# `byte` is one array entry per pixel holding 0-15 — the literal reading of the
# SDK docs, and unverified on hardware. If photos come out as noise or stripes,
# switch to `nibble`. See docs/photo-feed.md.
PHOTO_PIXEL_FORMAT=byte

# --- Display ----------------------------------------------------------------
# Romanise Cyrillic before it reaches the HUD. Off by default: G2 firmware has
# an `evenroster_crylgrek` fallback face, so Cyrillic normally renders fine.
DISPLAY_TRANSLITERATE=false

# --- Sessions ---------------------------------------------------------------
SESSION_TTL_DAYS=365
PAIRING_TTL_MINUTES=15
