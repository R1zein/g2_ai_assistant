{
  "name": "@g2/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "watch": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "dev": "tsc -p tsconfig.json && node --env-file-if-exists=../../.env --watch dist/index.js",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "test": "npm run build && node --test \"test/*.test.js\"",
    "verify:unsplash": "node scripts/verify-unsplash.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@fastify/cors": "^11.1.0",
    "@g2/shared": "*",
    "fastify": "^5.12.4",
    "googleapis": "^180.0.0",
    "sharp": "^0.35.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.7.3"
  }
}
