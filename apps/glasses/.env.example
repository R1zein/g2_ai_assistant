# Build-time configuration for the Even Hub app. Copy to apps/glasses/.env
#
# Must point at the assistant server as the *phone* can reach it, and the host
# must also appear in the `network` permission whitelist in app.json — the Even
# App enforces that list, and browser CORS applies on top of it.
VITE_API_BASE_URL=http://192.168.1.20:8787
