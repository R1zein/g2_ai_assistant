{
  "name": "@g2/glasses",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "qr": "evenhub qr",
    "simulator": "evenhub-simulator http://localhost:5173",
    "pack": "npm run build && evenhub pack app.json dist -o g2-ai-assistant.ehpk",
    "test": "node --experimental-strip-types --test \"test/*.test.ts\""
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "^0.0.15",
    "@evenrealities/pretext": "^0.1.4",
    "@g2/shared": "*"
  },
  "devDependencies": {
    "@evenrealities/evenhub-cli": "^0.1.14",
    "@evenrealities/evenhub-simulator": "^0.9.5",
    "typescript": "^5.7.3",
    "vite": "^6.0.0"
  }
}
